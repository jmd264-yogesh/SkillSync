generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  passwordHash   String    @map("password_hash")
  role           UserRole  @default(EMPLOYEE)
  employeeId      String?                  @unique @map("employee_id")
  employee        Employee?                @relation(fields: [employeeId], references: [id])
  reviewCycles    ReviewCycle[]
  feedbackForms   FeedbackForm[]
  formAssignments FeedbackFormAssignment[] @relation("AssignmentCreator")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Organization Structure ──────────────────────────────────

model Coe {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  employees   Employee[]
  coeSkills   CoeSkill[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("coes")
}

model Designation {
  id                String              @id @default(uuid())
  name              String              @unique
  level             Int
  description       String?
  employees         Employee[]
  designationSkills DesignationSkill[]
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("designations")
}

model CompetencyLevel {
  id          String   @id @default(uuid())
  level       Int      @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("competency_levels")
}

// ─── Employee ────────────────────────────────────────────────

model Employee {
  id                String          @id @default(uuid())
  employeeCode      String          @unique @map("employee_code")
  name              String
  email             String          @unique
  weeklyCapacity    Float           @default(40) @map("weekly_capacity")
  availableFrom     DateTime?       @map("available_from")
  costRate          Float?          @map("cost_rate")
  externalId        String?         @unique @map("external_id")
  jobName           String?         @map("job_name")
  department        String?
  location          String?
  dateOfJoin        DateTime?       @map("date_of_join")
  dateOfResignation DateTime?       @map("date_of_resignation")
  user              User?
  coe             Coe?            @relation(fields: [coeId], references: [id])
  coeId           String?         @map("coe_id")
  designation     Designation?    @relation(fields: [designationId], references: [id])
  designationId   String?         @map("designation_id")
  manager         Employee?       @relation("ManagerReports", fields: [managerId], references: [id])
  managerId       String?         @map("manager_id")
  reportees       Employee[]      @relation("ManagerReports")
  cluster         Cluster?        @relation(fields: [clusterId], references: [id])
  clusterId       String?         @map("cluster_id")
  employeeSkills  EmployeeSkill[]
  evidences       Evidence[]
  allocations          ProjectAllocation[]
  timesheets           Timesheet[]
  competencies         Competency[]
  utilisationSnapshots UtilisationSnapshot[]
  shadowFlags          ShadowFlag[]             @relation("ShadowEmployee")
  leaves               Leave[]
  managedProjects      Project[]                @relation("ProjectManager")
  reviewerAssignments  FeedbackFormAssignment[] @relation("AssignmentReviewer")
  revieweeAssignments  FeedbackFormAssignment[] @relation("AssignmentEmployee")
  feedbackSummaries    FeedbackSummary[]
  experienceDocs       ProjectExperienceDoc[]
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@index([clusterId])
  @@map("employees")
}

model Cluster {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("clusters")
}


// ─── Skills ──────────────────────────────────────────────────

model Skill {
  id                String              @id @default(uuid())
  name              String              @unique
  description       String?
  category          SkillCategory       @default(SKILL)
  employeeSkills      EmployeeSkill[]
  coeSkills           CoeSkill[]
  designationSkills   DesignationSkill[]
  projectRequirements ProjectSkillRequirement[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@map("skills")
}

enum SkillCategory {
  SKILL
  FRAMEWORK
  CONCEPT
  TOOL
  CERTIFICATION
}

// ─── Skill Mapping ───────────────────────────────────────────

model CoeSkill {
  id               String   @id @default(uuid())
  coe              Coe      @relation(fields: [coeId], references: [id], onDelete: Cascade)
  coeId            String   @map("coe_id")
  skill            Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId          String   @map("skill_id")
  targetCompetency Int      @map("target_competency")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([coeId, skillId])
  @@map("coe_skills")
}

model DesignationSkill {
  id               String      @id @default(uuid())
  designation      Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)
  designationId    String      @map("designation_id")
  skill            Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId          String      @map("skill_id")
  targetCompetency Int         @map("target_competency")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@unique([designationId, skillId])
  @@map("designation_skills")
}

// ─── Employee Skills & Validation ────────────────────────────

model EmployeeSkill {
  id                 String              @id @default(uuid())
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId         String              @map("employee_id")
  skill              Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId            String              @map("skill_id")
  selfAssessedLevel  Int                 @map("self_assessed_level")
  validatedLevel     Int?                @map("validated_level")
  status             SkillApprovalStatus @default(PENDING)
  reviewComment      String?             @map("review_comment")
  reviewedBy         String?             @map("reviewed_by")
  reviewedAt         DateTime?           @map("reviewed_at")
  evidences          Evidence[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

enum SkillApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Evidence ────────────────────────────────────────────────

model Evidence {
  id              String        @id @default(uuid())
  employeeSkill   EmployeeSkill @relation(fields: [employeeSkillId], references: [id], onDelete: Cascade)
  employeeSkillId String        @map("employee_skill_id")
  employee        Employee      @relation(fields: [employeeId], references: [id])
  employeeId      String        @map("employee_id")
  type            EvidenceType
  title           String
  description     String?
  fileUrl         String?       @map("file_url")
  score           String?
  issuedAt        DateTime?     @map("issued_at")
  expiresAt       DateTime?     @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("evidences")
}

enum EvidenceType {
  CERTIFICATION
  ASSESSMENT_SCORE
  PROJECT_DOCUMENT
  SUPPORTING_DOCUMENT
}

// ─── Learning Paths ──────────────────────────────────────────

model LearningPath {
  id          String         @id @default(uuid())
  title       String
  description String?
  skillId     String         @map("skill_id")
  fromLevel   Int            @map("from_level")
  toLevel     Int            @map("to_level")
  items       LearningItem[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("learning_paths")
}

model LearningItem {
  id             String          @id @default(uuid())
  learningPath   LearningPath    @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  learningPathId String          @map("learning_path_id")
  title          String
  description    String?
  type           LearningType
  url            String?
  duration       String?
  order          Int
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("learning_items")
}

enum LearningType {
  INTERNAL_TRAINING
  EXTERNAL_COURSE
  CERTIFICATION
  ASSESSMENT
  PROJECT_BASED
  DOCUMENTATION
}

// ─── Resource Management ─────────────────────────────────────

enum ClientTier {
  GOLD
  SILVER
  BRONZE
}

model Client {
  id                String     @id @default(uuid())
  name              String     @unique
  tier              ClientTier @default(BRONZE)
  relationshipSince DateTime?  @map("relationship_since")
  isNew             Boolean    @default(false) @map("is_new")
  industry          String?
  projects          Project[]
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("clients")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum RequirementPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ProjectCategory {
  D_AND_D
  TACTICAL_BUILD
  DATA_PLATFORM_BUILD
  ENTERPRISE_BUILD
  DATA_SCIENCE
  AI_PROJECT
  MS_PROJECT
  FULL_STACK
  VALUE_CREATION
  OTHER
}

enum PipelineStage {
  LEAD
  PROPOSAL
  SOW_PENDING
  SOW_SIGNED
  ACTIVE
  RAMP_DOWN
  CLOSED
}

enum Billability {
  BILLABLE
  PARTIALLY_BILLABLE
  UNBILLABLE
  SHADOW
}

model Project {
  id                String                    @id @default(uuid())
  name              String
  description       String?
  domain            String?
  startDate         DateTime?                 @map("start_date")
  endDate           DateTime?                 @map("end_date")
  teamSize          Int?                      @map("team_size")
  status               ProjectStatus             @default(ACTIVE)
  category             ProjectCategory           @default(TACTICAL_BUILD) @map("category")
  pipelineStage        PipelineStage             @default(ACTIVE) @map("pipeline_stage")
  sowSigned            Boolean                   @default(false) @map("sow_signed")
  sowSignedDate        DateTime?                 @map("sow_signed_date")
  plannedEndDate       DateTime?                 @map("planned_end_date")
  expectedStart        DateTime?                 @map("expected_start")
  winProbability       Int?                      @map("win_probability")
  clientPriority       Int?                      @map("client_priority")
  fundType             String?                   @map("fund_type")
  billRate             Float?                    @map("bill_rate")
  techCoe              String?                   @map("tech_coe")
  propositionCoe       String?                   @map("proposition_coe")
  clientId             String?                   @map("client_id")
  clientRef            Client?                   @relation(fields: [clientRefId], references: [id])
  clientRefId          String?                   @map("client_ref_id")
  actualEndDate        DateTime?                 @map("actual_end_date")
  externalId           String?                   @unique @map("external_id")
  projectKey           String?                   @map("project_key")
  reporterExternalId   String?                   @map("reporter_external_id")
  approverExternalId   String?                   @map("approver_external_id")
  projectManagerId     String?                   @map("project_manager_id")
  projectManager       Employee?                 @relation("ProjectManager", fields: [projectManagerId], references: [id])
  skillRequirements    ProjectSkillRequirement[]
  allocations          ProjectAllocation[]
  timesheets           Timesheet[]
  weeklyStatuses       WeeklyStatus[]
  feedbackAssignments  FeedbackFormAssignment[]
  experienceDocs       ProjectExperienceDoc[]
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectSkillRequirement {
  id            String              @id @default(uuid())
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String              @map("project_id")
  skill         Skill               @relation(fields: [skillId], references: [id])
  skillId       String              @map("skill_id")
  requiredLevel Int                 @map("required_level")
  headcount     Int                 @default(1)
  priority      RequirementPriority @default(MEDIUM)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([projectId, skillId])
  @@map("project_skill_requirements")
}

model ProjectAllocation {
  id           String      @id @default(uuid())
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String      @map("project_id")
  employee     Employee    @relation(fields: [employeeId], references: [id])
  employeeId   String      @map("employee_id")
  allocation        Float
  role              String?
  billability       Billability @default(BILLABLE) @map("billability")
  resourcingStatus  String?     @map("resourcing_status")
  externalId        String?     @unique @map("external_id")
  startDate         DateTime?   @map("start_date")
  endDate           DateTime?   @map("end_date")
  plannedEndDate    DateTime?   @map("planned_end_date")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@unique([projectId, employeeId])
  @@map("project_allocations")
}

model RoleMixTemplate {
  id            String          @id @default(uuid())
  category      ProjectCategory
  role          String
  designationId String?         @map("designation_id")
  fte           Float
  source        String          @default("DERIVED") @map("source")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([category, role])
  @@map("role_mix_templates")
}

model Leave {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  type       String   @default("UNPLANNED") @map("type")
  source     String   @default("MANUAL") @map("source")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("leaves")
}

// ─── Feedback & Promotion Readiness ──────────────────────────

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

model ReviewCycle {
  id          String            @id @default(uuid())
  name        String
  startDate   DateTime          @map("start_date")
  endDate     DateTime          @map("end_date")
  status      ReviewCycleStatus @default(DRAFT)
  createdById String            @map("created_by_id")
  createdBy   User              @relation(fields: [createdById], references: [id])
  forms       FeedbackForm[]
  assignments FeedbackFormAssignment[]
  summaries   FeedbackSummary[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("review_cycles")
}

enum FeedbackFormType {
  PM_FEEDBACK    // created by CDM/Manager, assigned to Project Managers
  CDM_ASSESSMENT // created by HR/Admin, assigned to CDMs/Managers
  HR_FEEDBACK    // created by HR/Admin, filled directly by HR
}

model FeedbackForm {
  id            String                 @id @default(uuid())
  title         String
  description   String?
  formType      FeedbackFormType       @map("form_type")
  reviewCycleId String                 @map("review_cycle_id")
  reviewCycle   ReviewCycle            @relation(fields: [reviewCycleId], references: [id])
  createdById   String                 @map("created_by_id")
  createdBy     User                   @relation(fields: [createdById], references: [id])
  sections      FeedbackFormSection[]
  assignments   FeedbackFormAssignment[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@map("feedback_forms")
}

model FeedbackFormSection {
  id          String                 @id @default(uuid())
  formId      String                 @map("form_id")
  form        FeedbackForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int
  questions   FeedbackFormQuestion[]
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@map("feedback_form_sections")
}

enum QuestionType {
  RATING // 1-5 numeric scale
  TEXT   // free-form narrative
}

model FeedbackFormQuestion {
  id        String               @id @default(uuid())
  sectionId String               @map("section_id")
  section   FeedbackFormSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text      String
  type      QuestionType
  required  Boolean              @default(true)
  order     Int
  responses FeedbackResponse[]
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@map("feedback_form_questions")
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  OVERDUE
}

model FeedbackFormAssignment {
  id            String           @id @default(uuid())
  reviewCycleId String           @map("review_cycle_id")
  reviewCycle   ReviewCycle      @relation(fields: [reviewCycleId], references: [id])
  formId        String           @map("form_id")
  form          FeedbackForm     @relation(fields: [formId], references: [id])
  reviewerId    String           @map("reviewer_id")
  reviewer      Employee         @relation("AssignmentReviewer", fields: [reviewerId], references: [id])
  employeeId    String           @map("employee_id")
  employee      Employee         @relation("AssignmentEmployee", fields: [employeeId], references: [id])
  projectId     String?          @map("project_id")
  project       Project?         @relation(fields: [projectId], references: [id])
  assignedById  String           @map("assigned_by_id")
  assignedBy    User             @relation("AssignmentCreator", fields: [assignedById], references: [id])
  status        AssignmentStatus @default(PENDING)
  dueDate       DateTime?        @map("due_date")
  submission    FeedbackSubmission?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@unique([reviewCycleId, formId, reviewerId, employeeId, projectId])
  @@index([reviewerId])
  @@index([employeeId])
  @@index([reviewCycleId])
  @@map("feedback_form_assignments")
}

model FeedbackSubmission {
  id           String                 @id @default(uuid())
  assignmentId String                 @unique @map("assignment_id")
  assignment   FeedbackFormAssignment @relation(fields: [assignmentId], references: [id])
  submittedAt  DateTime               @map("submitted_at")
  responses    FeedbackResponse[]
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@map("feedback_submissions")
}

model FeedbackResponse {
  id           String               @id @default(uuid())
  submissionId String               @map("submission_id")
  submission   FeedbackSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String               @map("question_id")
  question     FeedbackFormQuestion @relation(fields: [questionId], references: [id])
  ratingValue  Int?                 @map("rating_value")
  textValue    String?              @map("text_value")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([submissionId, questionId])
  @@map("feedback_responses")
}

enum PromotionStatus {
  READY_FOR_PROMOTION
  NEAR_READY
  NEEDS_DEVELOPMENT
  NOT_ELIGIBLE_YET
}

model FeedbackSummary {
  id                String          @id @default(uuid())
  reviewCycleId     String          @map("review_cycle_id")
  reviewCycle       ReviewCycle     @relation(fields: [reviewCycleId], references: [id])
  employeeId        String          @map("employee_id")
  employee          Employee        @relation(fields: [employeeId], references: [id])
  generatedAt       DateTime        @map("generated_at")
  summaryText       String          @map("summary_text")
  keyStrengths      String          @map("key_strengths")
  developmentAreas  String          @map("development_areas")
  skillReadiness    Float           @map("skill_readiness")
  feedbackReadiness Float           @map("feedback_readiness")
  compositeScore    Float           @map("composite_score")
  promotionStatus   PromotionStatus @map("promotion_status")
  promotionNotes    String?         @map("promotion_notes")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([reviewCycleId, employeeId])
  @@index([employeeId])
  @@map("feedback_summaries")
}

// ─── Resourcing CoLab: New Models ────────────────────────────

// Timesheet (file 04) — the truth source for utilisation & billability
model Timesheet {
  id          String    @id @default(uuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String    @map("employee_id")
  project     Project?  @relation(fields: [projectId], references: [id])
  projectId   String?   @map("project_id")
  isBillable  Boolean   @default(false) @map("is_billable")
  hours       Float     @default(0)
  date        DateTime
  status      String?
  externalKey String?   @unique @map("external_key")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([employeeId, date])
  @@index([projectId, date])
  @@map("timesheets")
}

// Competency (file 06 wide→long) — 5 consulting behaviour scores per employee
model Competency {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String   @map("employee_id")
  behaviour  String
  score      Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, behaviour])
  @@index([employeeId])
  @@map("competencies")
}

// PipelineRequest (file 07) — demand-side pipeline, pre-project
model PipelineRequest {
  id                String    @id @default(uuid())
  cluster           Int?
  client            String?
  requestType       String?   @map("request_type")
  clientPriority    String?   @map("client_priority")
  likelyStart       DateTime? @map("likely_start")
  numberOfWeeks     Float?    @map("number_of_weeks")
  dealStage         String?   @map("deal_stage")
  solution          String?
  resourcesRequested String?  @map("resources_requested")
  resourceRecommended Float?  @map("resource_recommended")
  percentAvailable  Float?    @map("percent_available")
  skillset          String?
  skillsetMatch     String?   @map("skillset_match")
  sowSigned              Boolean   @default(false) @map("sow_signed")
  status                 String?
  comments               String?
  // Enhancement fields (WI-008)
  serviceLine            String?   @map("service_line")
  solutionPriority       Int?      @map("solution_priority")
  confidence             Int       @default(20)
  isNewClient            Boolean   @default(false) @map("is_new_client")
  clientRelationshipMonths Int?    @map("client_relationship_months")
  clientTier             String?   @map("client_tier")
  dealLostAt             DateTime? @map("deal_lost_at")
  hiringLeadTimeAlert    Boolean   @default(false) @map("hiring_lead_time_alert")
  // Project-detail enrichment fields (from project_details.csv / file 02)
  projectKey             String?   @map("project_key")
  techCoe                String?   @map("tech_coe")
  propositionCoe         String?   @map("proposition_coe")
  reporterExternalId     String?   @map("reporter_external_id")
  approverExternalId     String?   @map("approver_external_id")
  clientExternalId       String?   @map("client_external_id")
  typeOfProject          String?   @map("type_of_project")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([cluster])
  @@index([sowSigned])
  @@index([dealLostAt])
  @@map("pipeline_requests")
}

// WeeklyStatus (file 09) — per-project RAG signals
model WeeklyStatus {
  id             String   @id @default(uuid())
  project        Project  @relation(fields: [projectId], references: [id])
  projectId      String   @map("project_id")
  weekStart      DateTime @map("week_start")
  weekEnd        DateTime @map("week_end")
  scopeStatus    String?  @map("scope_status")
  scheduleStatus String?  @map("schedule_status")
  qualityStatus  String?  @map("quality_status")
  csatStatus     String?  @map("csat_status")
  teamStatus     String?  @map("team_status")
  externalKey    String?  @unique @map("external_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([projectId, weekStart])
  @@map("weekly_statuses")
}

// UtilisationSnapshot — derived weekly from timesheets per employee
model UtilisationSnapshot {
  id              String   @id @default(uuid())
  employee        Employee @relation(fields: [employeeId], references: [id])
  employeeId      String   @map("employee_id")
  weekStart       DateTime @map("week_start")
  totalHours      Float    @default(0) @map("total_hours")
  billableHours   Float    @default(0) @map("billable_hours")
  utilisation     Float    @default(0)
  billableUtil    Float    @default(0) @map("billable_util")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([employeeId, weekStart])
  @@index([employeeId])
  @@map("utilisation_snapshots")
}

enum ShadowFlagType {
  SHADOW
  GHOST
}

// ShadowFlag — derived from allocations vs timesheet join
model ShadowFlag {
  id         String         @id @default(uuid())
  employee   Employee       @relation("ShadowEmployee", fields: [employeeId], references: [id])
  employeeId String         @map("employee_id")
  projectId  String         @map("project_id")
  flagType   ShadowFlagType @map("flag_type")
  detectedAt DateTime       @map("detected_at")
  hours      Float          @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([projectId])
  @@index([employeeId])
  @@map("shadow_flags")
}

// ─── Project Experience Documents ───────────────────────────

model ProjectExperienceDoc {
  id               String    @id @default(uuid())
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId       String    @map("employee_id")

  title            String
  clientIndustry   String?   @map("client_industry")
  projectType      String    @map("project_type")
  techStack        String?   @map("tech_stack")
  businessContext  String?   @map("business_context")
  solutionProvided String?   @map("solution_provided")
  myRole           String?   @map("my_role")
  teamSize         Int?      @map("team_size")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  rawText          String?   @map("raw_text")

  extractionStatus String    @default("DRAFT") @map("extraction_status")
  extractedSkills  String?   @map("extracted_skills")
  aiSummary        String?   @map("ai_summary")

  projectId        String?   @map("project_id")
  project          Project?  @relation(fields: [projectId], references: [id])

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([employeeId])
  @@map("project_experience_docs")
}

// IngestReport — one row per ETL run, tracks data quality
model IngestReport {
  id             String   @id @default(uuid())
  runAt          DateTime @map("run_at")
  fileName       String   @map("file_name")
  rowsLoaded     Int      @default(0) @map("rows_loaded")
  rowsDropped    Int      @default(0) @map("rows_dropped")
  nullsCoerced   Int      @default(0) @map("nulls_coerced")
  unmappedValues Int      @default(0) @map("unmapped_values")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("ingest_reports")
}
